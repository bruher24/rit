{% endblock %}
{% block content %}
{% if errors %}
<div class="alert alert-danger">
    <ul>
        {% for error in errors%}
        <li>{{ error }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}
<div class="container" style="max-width:600px;margin:60px auto;">
    <form role="form" class="form-control" method="{% if active is not null %} put {% else %} post {% endif %}"
          action="{% if active is not null %} {{ url_for('actives.update', {"id": active.getId()}) }}
                    {% else %} {{ url_for('actives.create') }}">
        {% if active is not null %}
        <input type="hidden" name="active_id" value="{{ active.getId() }}">
        {% endif %}

        <div class="input-group">
            <label class="form-label" for="active_name">
                Название:
                <input class="form-control" id="active_name" name="name" type="text" placeholder="Введите название"
                       value="{{ active ? active.getName() : '' }}">
            </label>
        </div>
        <div class="input-group">
            <label class="form-label" for="category_id">
                Категория:
                <select class="form-select form-control" id="category_id" name="category_id" >
                    <option selected disabled>Выберите категорию...</option>
