{% extends 'layout.twig'%}
{% block title %}
Список активов
{% endblock %}
{% block content %}

<div class="container">
    <a href="">
        <button class="btn btn-success mb-1">Добавить актив</button>
    </a>
    <table class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th>Детали</th>
            <th>Стоимость</th>
            <th>Действия</th>
        </tr>
        {% for active in actives %}
        <tr>
            <th>{{ active.getName() ?? 'no'}}</th>
            <th>{{ active.getDetails() ?? 'no' }}</th>
            <th>{{ active.getTotalCost() ?? 'no'}}</th>
            <th>
                <a class="btn btn-sm btn-warning" href="{{ url_for('actives.updateForm', {'id': active.getId() }) }}">Изменить</a>
                <a class="btn btn-sm btn-danger" href="{{ url_for('actives.update', {'id': active.getId()  }) }}">Удалить</a>
            </th>
        </tr>
        {% endfor %}
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
{% endblock %}